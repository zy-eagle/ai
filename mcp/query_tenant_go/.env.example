# ===========================================
# MCP Query Server (Go) — Environment Configuration
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Custom path: set ENV_FILE=/path/to/your.env to load from a different location.

# Target API base URL (HTTPS recommended; set ALLOW_HTTP=true for internal networks)
BASE_URL=https://mydomain.com

# Allow HTTP connections (only for internal/dev networks, default: false)
ALLOW_HTTP=false

# --- Authentication Mode ---
# Choose one: "session" or "aksk"
AUTH_MODE=session

# --- Session Mode ---
# Used when AUTH_MODE=session
SESSION_TOKEN=your-session-token-here
# Header name for the session token (default: Authorization)
SESSION_HEADER_NAME=Authorization

# --- AK/SK Mode ---
# Used when AUTH_MODE=aksk
ACCESS_KEY=your-access-key-here
SECRET_KEY=your-secret-key-here
